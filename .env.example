DATABASE_URL=postgresql://treasury:replace-me@127.0.0.1:5432/treasury
APP_ORIGIN=https://treasury.example.com
PORT=3000
DATABASE_POOL_MAX=10

# Generate independent values with a CSPRNG. Each value must decode from base64
# to at least 32 bytes; the TOTP encryption key must decode to exactly 32 bytes.
LOGIN_THROTTLE_HMAC_KEY_BASE64=replace-with-at-least-32-random-bytes
COMMAND_DIGEST_HMAC_KEY_BASE64=replace-with-an-independent-32-byte-key
# A versioned keyring retains old keys while ciphertext is rotated. For a first
# deployment, the single-key fallback below is accepted with TOTP_KEY_VERSION.
TOTP_ENCRYPTION_KEYS_JSON={"1":"replace-with-exactly-32-random-bytes"}
# TOTP_ENCRYPTION_KEY_BASE64=single-key-fallback
TOTP_KEY_VERSION=1

# Calibrate on the deployment class and keep identical across replicas.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
